{
  "name": "forge-backend",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot ./src/server.ts",
    "build": "bun build ./src/server.ts --target bun --outdir ./dist",
    "start": "bun ./dist/server.js",
    "vercel-build": "bunx --bun prisma generate && bun build ./src/index.ts --target node --format esm --packages external --outfile ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:generate": "bunx --bun prisma generate",
    "db:studio": "bunx --bun prisma studio",
    "db:seed:exercises": "bun ./src/scripts/seed-exercises.ts",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.27",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/express-api-reference": "^0.10.26",
    "better-auth": "^1.6.27",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.2"
  }
}
