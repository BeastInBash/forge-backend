// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @unique @default(uuid())
  name          String
  email         String         @unique
  bio           String?
  workout_plan  Workout_Plan[]
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  exercises     Exercise[]
  lift_logs     Lift_Log[]
  meals         Meal[]
  /// Onboarding answers; each one is optional because every step can be skipped
  age           Int?
  /// Height in cm
  heightCm      Float?
  /// Body weight in kg
  weightKg      Float?
  goal          Fitness_Goal?
  /// Set when the user finishes or skips onboarding; null means it hasn't been shown yet
  onboardedAt   DateTime?

  @@map("user")
}

enum Fitness_Goal {
  WEIGHT_LOSS
  WEIGHT_GAIN
  MUSCLE_BUILDING
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workout_Plan {
  id               String             @id @unique @default(uuid())
  day              String
  time             DateTime
  muscle_group     String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  workoutExercises Workout_Exercise[]

  @@index([userId])
  @@map("workout_plan")
}

model Exercise {
  id             String             @id @default(uuid())
  exercise_name  String
  name_key       String             @unique
  exercise_video String?
  exercise_icon  String?
  createdById    String?
  createdBy      User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  workout_items  Workout_Exercise[]
  lift_logs      Lift_Log[]

  @@index([createdById])
  @@map("exercise")
}

model Workout_Exercise {
  id             String       @id @default(uuid())
  workout_PlanId String
  exerciseId     String
  repetition     Int
  sets           Int
  /// Working weight in kg; null for bodyweight exercises
  weight         Float?
  order          Int
  workoutPlan    Workout_Plan @relation(fields: [workout_PlanId], references: [id], onDelete: Cascade)
  exercise       Exercise     @relation(fields: [exerciseId], references: [id])

  @@unique([workout_PlanId, exerciseId])
  @@index([exerciseId])
  @@map("workout_exercise")
}

/// One exercise performed in one session: the sets actually lifted, for progress tracking
model Lift_Log {
  id          String     @id @default(uuid())
  userId      String
  exerciseId  String
  performedAt DateTime
  note        String?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise    Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets        Lift_Set[]

  @@index([userId, exerciseId, performedAt])
  @@map("lift_log")
}

model Lift_Set {
  id        String   @id @default(uuid())
  liftLogId String
  /// Load in kg; null for bodyweight
  weight    Float?
  reps      Int
  order     Int
  liftLog   Lift_Log @relation(fields: [liftLogId], references: [id], onDelete: Cascade)

  @@index([liftLogId])
  @@map("lift_set")
}

/// One logged meal. Its nutrition is never stored: it is calculated from the items on read.
model Meal {
  id            String      @id @default(uuid())
  userId        String
  /// "breakfast" | "lunch" | "dinner" | "snack", validated by Zod
  mealTime      String
  eatenAt       DateTime
  /// Provider and model that estimated the items, e.g. "gemini/gemini-3.5-flash-lite"
  aiModel       String
  /// PROMPT_VERSION in meal.services.ts when the meal was analysed
  promptVersion Int
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         Meal_Item[]

  @@index([userId, eatenAt])
  @@map("meal")
}

/// One food in a meal: what the user typed and the AI's estimate for it.
model Meal_Item {
  id         String  @id @default(uuid())
  mealId     String
  /// The name and amount as the user typed them
  food       String
  amount     String
  /// What the AI understood, e.g. "Chicken breast"
  name       String
  grams      Float
  /// "raw" | "cooked" | null
  state      String?
  assumption String?
  confidence Float
  /// Estimated nutrients per 100 g, keyed like NUTRIENTS in src/common/utils/nutrition.ts
  per100g    Json
  order      Int
  meal       Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("meal_item")
}

model Food_Items {
  id                    String                  @id
  food_image            String?
  food_name             String
  calorie_value         String
  nutrition_information Nutrition_Information[]
  mealTime              Meal_Time?              @relation(fields: [meal_TimeId], references: [id])
  meal_TimeId           String?

  @@map("food_items")
}

model Nutrition_Information {
  id                 String      @id
  name               String
  nutrition_qunatity String
  foodItems          Food_Items? @relation(fields: [food_ItemsId], references: [id])
  food_ItemsId       String?

  @@map("nutrition")
}

model Meal_Time {
  id         String       @id @default(uuid())
  time_name  String
  food_items Food_Items[]
}

model Diet {
  id String @id
}
